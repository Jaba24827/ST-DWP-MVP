APP_NAME="SL-DWP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Port-au-Prince
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sldwp
DB_USERNAME=sldwp_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false   # true behind HTTPS
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
SLDWP_DOC_DISK=local
SLDWP_MFA_TTL=300             # seconds
SLDWP_MFA_MAX_ATTEMPTS=5
SLDWP_PASSWORD_MIN=12
SLDWP_PASSWORD_HISTORY=5
SLDWP_LOGIN_THROTTLE=5        # attempts per minute per email+ip

MAIL_MAILER=log               # 'log' writes MFA mails to storage/logs in development
MAIL_FROM_ADDRESS="no-reply@stlukehaiti.org"
MAIL_FROM_NAME="${APP_NAME}"

SMS_DRIVER=log                # swap for a real gateway in production
SMS_FROM="SL-DWP"
